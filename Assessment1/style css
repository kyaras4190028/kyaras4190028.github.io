body {
    margin: 0;
    background-color: #8b5a2b;
    font-family: Arial, sans-serif;
}

.corkboard {
    min-height: 100vh;
    padding: 40px;
    
    /* Cork colour */
    background-color: #b97845;

    /* Cork texture */
    background-image:
        radial-gradient(#8f5b35 1px, transparent 1px),
        radial-gradient(#d49a62 1px, transparent 1px);

    background-size: 12px 12px, 18px 18px;
    background-position: 0 0, 6px 6px;

    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.35);
}

h1 {
    text-align: center;
    color: white;
    text-shadow: 2px 2px 4px #5c351c;
}

.sticky-note {
    width: 200px;
    min-height: 150px;
    padding: 20px;
    
    background: #fff3a6;
    
    box-shadow: 4px 6px 10px rgba(0, 0, 0, 0.3);
    
    transform: rotate(-3deg);
}